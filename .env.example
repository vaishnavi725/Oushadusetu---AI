# Front end (public-safe only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=          # anon / publishable key only; never the service-role key
VITE_API_BASE_URL=
VITE_APP_ENV=                    # development | staging | production
VITE_USE_MOCKS=                  # true in Phase 4

# Server only (Supabase Edge Function secrets)
# AI chat (optional — demo works without any key via built-in replies)
GROQ_API_KEY=                    # Groq Cloud (console.groq.com). This is Groq, not xAI Grok.
GROQ_MODEL=                      # optional; default llama-3.1-8b-instant
OPENAI_API_KEY=                  # optional; used only if GROQ_API_KEY is empty
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # server only; never sent to the browser
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PHI_ENCRYPTION_KEY=              # base64, 32 bytes
BLIND_INDEX_KEY=                 # base64, 32 bytes
STATUS_TOKEN_PEPPER=
PHARMACY_WEBHOOK_SECRET=
SMS_WEBHOOK_SECRET=
ALLOWED_ORIGINS=                 # comma-separated front-end origins
APP_BASE_URL=
APP_ENV=
ENABLE_DEMO_SIMULATOR=           # false in production
SENTRY_DSN=                      # optional
LOG_LEVEL=
